#!/usr/bin/env python3
"""
AIfred Admin CLI

Manage whitelist and user accounts from command line.

Usage:
    aifred-admin users                          List allowed users (whitelist)
    aifred-admin add <username>                 Add user to whitelist
    aifred-admin remove <username>              Remove user from whitelist
    aifred-admin accounts                       List registered accounts
    aifred-admin create <username> [password]   Create account (prompts for PW if omitted)
    aifred-admin delete <username>              Delete account (with confirmation)
    aifred-admin delete <username> --sessions   Also delete user's sessions
"""

import sys
import os
import json
import getpass
from pathlib import Path

# Password hashing with bcrypt — MUST mirror the format + rounds of
# aifred/lib/session_storage.py (prefix "bcrypt:", rounds 12) so accounts
# created via the CLI can log in. bcrypt lives in the venv, so re-exec with
# the venv Python to keep ./aifred-admin directly runnable. Deliberately NO
# import of session_storage: that would drag config.py with its import-time
# side effects (loading API keys, initializing the debug log) into every CLI
# invocation — just to share a two-line hash function.
PROJECT_ROOT = Path(__file__).resolve().parent
_VENV = PROJECT_ROOT / "venv"
_VENV_PY = _VENV / "bin" / "python3"
# Loop guard via sys.prefix, NOT via the interpreter binary: venv/bin/python3
# is a symlink to the system python, so comparing resolved binaries would
# never detect "already inside the venv" (the venv works through pyvenv.cfg
# → sys.prefix, not through a distinct binary).
if _VENV_PY.exists() and Path(sys.prefix).resolve() != _VENV.resolve():
    os.execv(str(_VENV_PY), [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])

import bcrypt  # noqa: E402 — after the venv re-exec, else possibly not on path

_BCRYPT_PREFIX = "bcrypt:"       # mirrors session_storage._BCRYPT_PREFIX
_BCRYPT_ROUNDS = 12              # mirrors session_storage._BCRYPT_ROUNDS

# Paths MUST match aifred/lib/config.py DATA_DIR = PROJECT_ROOT / "data"
# (not ~/.config/aifred which never existed)
SETTINGS_DIR = PROJECT_ROOT / "data"
WHITELIST_FILE = SETTINGS_DIR / "allowed_users.json"
ACCOUNTS_FILE = SETTINGS_DIR / "accounts.json"
SESSION_DIR = SETTINGS_DIR / "sessions"


def hash_password(password: str) -> str:
    """bcrypt hash in the same format as session_storage.hash_password."""
    digest = bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt(_BCRYPT_ROUNDS))
    return f"{_BCRYPT_PREFIX}{digest.decode('ascii')}"


def _save_accounts(accounts: dict) -> bool:
    """Save accounts atomically + 0600 (password hashes must not be world-readable).
    Mirrors session_storage._save_accounts (tmp + chmod + os.replace)."""
    try:
        SETTINGS_DIR.mkdir(parents=True, exist_ok=True)
        tmp_path = ACCOUNTS_FILE.with_suffix(".json.tmp")
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(accounts, f, ensure_ascii=False, indent=2)
        os.chmod(tmp_path, 0o600)
        os.replace(tmp_path, ACCOUNTS_FILE)
        return True
    except OSError:
        return False


def _load_whitelist() -> list:
    """Load whitelist from file."""
    if not WHITELIST_FILE.exists():
        return []
    try:
        with open(WHITELIST_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            return [u.lower() for u in data if isinstance(u, str)]
    except (json.JSONDecodeError, IOError):
        return []


def _save_whitelist(whitelist: list) -> bool:
    """Save whitelist to file."""
    try:
        SETTINGS_DIR.mkdir(parents=True, exist_ok=True)
        with open(WHITELIST_FILE, "w", encoding="utf-8") as f:
            json.dump(whitelist, f, ensure_ascii=False, indent=2)
        return True
    except IOError:
        return False


def _load_accounts() -> dict:
    """Load accounts from file."""
    if not ACCOUNTS_FILE.exists():
        return {}
    try:
        with open(ACCOUNTS_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except (json.JSONDecodeError, IOError):
        return {}


def get_whitelist() -> list:
    return _load_whitelist()


def add_to_whitelist(username: str) -> bool:
    if not username:
        return False
    whitelist = _load_whitelist()
    username_lower = username.lower()
    if username_lower in whitelist:
        return False
    whitelist.append(username_lower)
    return _save_whitelist(whitelist)


def remove_from_whitelist(username: str) -> bool:
    if not username:
        return False
    whitelist = _load_whitelist()
    username_lower = username.lower()
    if username_lower not in whitelist:
        return False
    whitelist.remove(username_lower)
    return _save_whitelist(whitelist)


def list_accounts() -> list:
    return list(_load_accounts().keys())


def list_sessions(owner: str) -> list:
    """List sessions for owner."""
    if not SESSION_DIR.exists():
        return []
    sessions = []
    for session_file in SESSION_DIR.glob("*.json"):
        try:
            with open(session_file, "r", encoding="utf-8") as f:
                data = json.load(f)
            if data.get("owner", "").lower() == owner.lower():
                sessions.append(session_file.stem)
        except (json.JSONDecodeError, IOError):
            continue
    return sessions


def delete_account(username: str, delete_sessions: bool = False) -> bool:
    if not username:
        return False
    username_lower = username.lower()
    accounts = _load_accounts()
    if username_lower not in accounts:
        return False

    if delete_sessions and SESSION_DIR.exists():
        for session_file in SESSION_DIR.glob("*.json"):
            try:
                with open(session_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if data.get("owner", "").lower() == username_lower:
                    session_file.unlink()
            except (json.JSONDecodeError, IOError):
                continue

    del accounts[username_lower]
    return _save_accounts(accounts)


def cmd_users() -> None:
    """List whitelist users."""
    users = get_whitelist()
    if not users:
        print("Whitelist is empty.")
        print(f"File: {WHITELIST_FILE}")
        return

    print(f"Allowed users ({len(users)}):")
    for user in sorted(users):
        print(f"  • {user}")
    print(f"\nFile: {WHITELIST_FILE}")


def cmd_add(username: str) -> None:
    """Add user to whitelist."""
    if not username:
        print("Error: username required")
        sys.exit(1)

    if add_to_whitelist(username):
        print(f"✓ '{username}' added to whitelist")
    else:
        print(f"✗ '{username}' is already on the whitelist")


def cmd_remove(username: str) -> None:
    """Remove user from whitelist."""
    if not username:
        print("Error: username required")
        sys.exit(1)

    if remove_from_whitelist(username):
        print(f"✓ '{username}' removed from whitelist")
    else:
        print(f"✗ '{username}' not found on whitelist")


def cmd_accounts() -> None:
    """List registered accounts."""
    accounts = list_accounts()
    whitelist = get_whitelist()

    if not accounts:
        print("No registered accounts.")
        print(f"File: {ACCOUNTS_FILE}")
        return

    print(f"Registered accounts ({len(accounts)}):")
    for acc in sorted(accounts):
        # Count sessions for this user
        sessions = list_sessions(owner=acc)
        session_count = len(sessions)
        on_whitelist = "✓" if acc in whitelist else "✗"
        print(f"  • {acc} (whitelist: {on_whitelist}, sessions: {session_count})")

    print(f"\nFile: {ACCOUNTS_FILE}")


def cmd_create(username: str, password: str = "") -> None:
    """Create new account (or fail if exists).

    Adds username to whitelist if not already there, hashes the
    password, and stores it in accounts.json. Prompts interactively
    for the password if omitted.
    """
    if not username:
        print("Error: username required")
        sys.exit(1)

    username_lower = username.lower()
    accounts = _load_accounts()

    if username_lower in accounts:
        print(f"✗ Account '{username}' already exists")
        print(f"  To replace it: ./aifred-admin delete {username} && ./aifred-admin create {username}")
        sys.exit(1)

    # Ensure whitelist entry exists (create_account() in the app requires it)
    whitelist = _load_whitelist()
    if username_lower not in whitelist:
        whitelist.append(username_lower)
        if _save_whitelist(whitelist):
            print(f"✓ '{username}' added to whitelist")
        else:
            print("✗ Could not save whitelist")
            sys.exit(1)

    # Get password — either from CLI arg or interactive prompt
    if not password:
        password = getpass.getpass(f"Password for '{username}': ")
        password_confirm = getpass.getpass("Repeat password: ")
        if password != password_confirm:
            print("✗ Passwords do not match")
            sys.exit(1)

    if len(password) < 6:
        print("✗ Password must be at least 6 characters long")
        sys.exit(1)

    accounts[username_lower] = hash_password(password)
    if _save_accounts(accounts):
        print(f"✓ Account '{username}' created")
        print(f"  File: {ACCOUNTS_FILE}")
    else:
        print("✗ Error saving accounts")
        sys.exit(1)


def cmd_delete(username: str, with_sessions: bool = False) -> None:
    """Delete account."""
    if not username:
        print("Error: username required")
        sys.exit(1)

    # Check if account exists
    accounts = list_accounts()
    if username.lower() not in accounts:
        print(f"✗ Account '{username}' not found")
        sys.exit(1)

    # Count sessions
    sessions = list_sessions(owner=username)
    session_count = len(sessions)

    # Confirmation
    if with_sessions and session_count > 0:
        print(f"WARNING: delete account '{username}' with {session_count} sessions?")
    else:
        print(f"Delete account '{username}'?")

    confirm = input("Confirm with 'yes': ")
    if confirm.lower() != "yes":
        print("Aborted.")
        return

    if delete_account(username, delete_sessions=with_sessions):
        msg = f"✓ Account '{username}' deleted"
        if with_sessions:
            msg += f" (incl. {session_count} sessions)"
        print(msg)
    else:
        print(f"✗ Error deleting '{username}'")


def print_help() -> None:
    """Print usage help."""
    print(__doc__)


def main() -> None:
    """Main entry point."""
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()

    if cmd in ("help", "-h", "--help"):
        print_help()
    elif cmd == "users":
        cmd_users()
    elif cmd == "add":
        username = sys.argv[2] if len(sys.argv) > 2 else ""
        cmd_add(username)
    elif cmd == "remove":
        username = sys.argv[2] if len(sys.argv) > 2 else ""
        cmd_remove(username)
    elif cmd == "accounts":
        cmd_accounts()
    elif cmd == "create":
        username = sys.argv[2] if len(sys.argv) > 2 else ""
        password = sys.argv[3] if len(sys.argv) > 3 else ""
        cmd_create(username, password)
    elif cmd == "delete":
        username = sys.argv[2] if len(sys.argv) > 2 else ""
        with_sessions = "--sessions" in sys.argv
        cmd_delete(username, with_sessions)
    else:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
