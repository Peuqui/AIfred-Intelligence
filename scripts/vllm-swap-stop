#!/usr/bin/env bash
# llama-swap cmdStop fuer vLLM-Eintraege: beendet den kompletten Prozessbaum.
#
# Hintergrund: vLLMs Multiproc-Worker loesen sich aus der Prozessgruppe
# (Ctrl+C-Schutz), und der API-Server stirbt auf SIGTERM schneller, als
# llama-swaps terminateProcessTree die Kinder einsammeln kann — die Worker
# verwaisen zu PID 1 und halten das VRAM (beobachtet 2026-08-28: 131 GB,
# der nachfolgende llama-server scheiterte am KV-Cache-Alloc). Deshalb hier:
# Nachfahren VOR dem ersten Signal einsammeln, gemeinsam TERM, nach Timeout KILL.
#
# Aufruf (llama-swap config):  cmdStop: <pfad>/vllm-swap-stop ${PID}
set -u
PID="${1:?usage: vllm-swap-stop <pid>}"

descendants() {
    local child
    for child in $(ps -o pid= --ppid "$1" 2>/dev/null); do
        descendants "$child"
        echo "$child"
    done
}

# shellcheck disable=SC2046  # Wortsplitting der PID-Liste ist hier gewollt
ALL="$(descendants "$PID") $PID"
kill -TERM $ALL 2>/dev/null

for _ in $(seq 1 25); do
    alive=0
    for p in $ALL; do
        kill -0 "$p" 2>/dev/null && alive=1 && break
    done
    [ "$alive" -eq 0 ] && exit 0
    sleep 1
done

kill -KILL $ALL 2>/dev/null
exit 0
