{
  "name": "aifred-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api-types": "cd .. && AIFRED_CLI_MODE=1 PYTHONPATH=. venv/bin/python scripts/export_openapi.py frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "pretypecheck": "npm run api-types",
    "typecheck": "vue-tsc --noEmit",
    "prebuild": "npm run api-types",
    "build": "vue-tsc --noEmit && vite build",
    "pretest": "npm run api-types",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-texmath": "1.0.0",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "vuefinder": "4.7.6"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
