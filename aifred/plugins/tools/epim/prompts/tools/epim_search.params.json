{
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [],
      "description": "What to search"
    },
    "query": {
      "type": "string",
      "description": "Search text in title, name or subject; for notes also in the text. Omit to list entries."
    },
    "date_from": {
      "type": "string",
      "description": "tasks only: first day, YYYY-MM-DD"
    },
    "date_to": {
      "type": "string",
      "description": "tasks only: last day (inclusive), YYYY-MM-DD"
    },
    "completed": {
      "type": "boolean",
      "description": "todos only: true = done, false = open"
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of results (default 20)"
    }
  },
  "required": ["entity_type"]
}
