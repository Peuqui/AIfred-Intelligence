# AIfred Intelligence - Environment Configuration
# Copy this file to .env and adjust values to your setup

# Backend URL for static files (HTML preview, images)
# With NGINX: leave empty — NGINX routes /_upload/ to the backend
# Without NGINX: the backend URL as seen from the browser
# BACKEND_URL=http://localhost:8002

# External host name (reverse proxy / own domain). Added to Vite's
# allowedHosts on every service start by scripts/patch-vite-config.sh.
# Leave unset for local-only access.
# AIFRED_ALLOWED_HOST=example.com

# STT-Suite checkout (github.com/Peuqui/STT-Suite, speech recognition). install-all.sh
# clones it there and AIfred starts its container on demand (on a machine without an
# NVIDIA GPU with its docker-compose.cpu.yml). Default: STT-Suite next to the AIfred
# directory.
# STT_SUITE_DIR=/home/you/STT-Suite

# TTS-Suite checkout (github.com/Peuqui/TTS-Suite, spoken output). install-all.sh
# clones it there and runs its deploy/install.sh. Default: TTS-Suite next to the AIfred
# directory. (Only the installer reads this; AIfred talks to the service by URL.)
# TTS_SUITE_DIR=/home/you/TTS-Suite

# TTS-Suite-Dienst (Sprachausgabe): Adresse. AIfred liest und spricht nur, ein
# Token braucht es dafür nicht (Hosts und Start/Stopp stellt man in der
# Weboberfläche der Suite ein).
# TTS_SUITE_URL=http://127.0.0.1:5090

# GPU-Orc (räumt vor dem Laden eines Modells die Karten frei, github.com/Peuqui/GPU-Orc): Adresse und
# Name des llama-swap-Verbrauchers in seiner Config.
# GPU_ORC_URL=http://127.0.0.1:5070
# GPU_ORC_MODEL_SERVER=llama-swap

# Sprachausgabe im Browser-Fenster: Stille zwischen zwei Absätzen in ms (0 = keine Pause).
# BROWSER_PARAGRAPH_PAUSE_MS=0

# AIfred account that owns the sessions of the Message Hub (Telegram,
# Discord, e-mail, FreeEcho.2, scheduler). Required — set by install-all.sh.
# MESSAGE_HUB_OWNER=yourname
