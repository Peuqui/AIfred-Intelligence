# AIfred Intelligence - Environment Configuration
# Copy this file to .env and adjust values to your setup

# STT-Suite checkout (github.com/Peuqui/STT-Suite, speech recognition). install-all.sh
# clones it there and AIfred starts its container on demand (on a machine without an
# NVIDIA GPU with its docker-compose.cpu.yml). Default: STT-Suite next to the AIfred
# directory.
# STT_SUITE_DIR=/home/you/STT-Suite

# TTS-Suite checkout (github.com/Peuqui/TTS-Suite, spoken output). install-all.sh
# clones it there and runs its deploy/install.sh. Default: TTS-Suite next to the AIfred
# directory. (Only the installer reads this; AIfred talks to the service by URL.)
# TTS_SUITE_DIR=/home/you/TTS-Suite

# GPU-Orc checkout (github.com/Peuqui/GPU-Orc, clears the cards before a load). install-all.sh
# clones it there and runs its deploy/install.sh. Default: GPU-Orc next to the AIfred directory.
# (Only the installer reads this; AIfred talks to the service by GPU_ORC_URL.)
# GPU_ORC_DIR=/home/you/GPU-Orc

# TTS-Suite-Dienst (Sprachausgabe): Adresse. AIfred liest und spricht nur, ein
# Token braucht es dafür nicht (Hosts und Start/Stopp stellt man in der
# Weboberfläche der Suite ein).
# TTS_SUITE_URL=http://127.0.0.1:5090

# GPU-Orc (räumt vor dem Laden eines Modells die Karten frei, github.com/Peuqui/GPU-Orc): Adresse und
# Name des llama-swap-Verbrauchers in seiner Config.
# GPU_ORC_URL=http://127.0.0.1:5070
# GPU_ORC_MODEL_SERVER=llama-swap

# Bildbeschreiber auf anderen Rechnern (eigener llama-swap und eigener GPU-Orc dort), JSON-Liste,
# ein Eintrag je Rechner. Welches Modell dort beschreibt, wählt man in den Vigilantia-Einstellungen;
# die Modelle meldet der llama-swap des Rechners selbst. Der GPU-Orc dort lauscht im Netz und will
# sein Token (Datei nur für den Benutzer lesbar). Leer = Beschreiber nur auf diesem Rechner.
# VISION_REMOTE_HOSTS=[{"name": "Workstation", "llamaswap_url": "http://192.168.1.50:11435", "gpu_orc_url": "http://192.168.1.50:5070", "gpu_orc_token_file": "~/.config/gpu-orc/workstation.token"}]

# Sprachausgabe im Browser-Fenster: Stille zwischen zwei Absätzen in ms (0 = keine Pause).
# BROWSER_PARAGRAPH_PAUSE_MS=0

# AIfred account that owns the sessions of the Message Hub (Telegram,
# Discord, e-mail, FreeEcho.2, scheduler). Required — set by install-all.sh.
# MESSAGE_HUB_OWNER=yourname

# Tool-call limits per channel and window (0 = unlimited); a channel that breaks its limit
# SECURITY_RATE_BREAKER_THRESHOLD times within the window is blocked for the cooldown.
# SECURITY_RATE_LIMIT_WINDOW_SEC=60
# SECURITY_RATE_LIMIT_EMAIL=5
# SECURITY_RATE_LIMIT_DISCORD=10
# SECURITY_RATE_LIMIT_TELEGRAM=10
# SECURITY_RATE_LIMIT_AI_CONNECT=10
# SECURITY_RATE_LIMIT_CRON=20
# SECURITY_RATE_LIMIT_WEBHOOK=3
# SECURITY_RATE_BREAKER_THRESHOLD=3
# SECURITY_RATE_BREAKER_COOLDOWN_SEC=300
# A tool repeated with the same arguments (a write) or the same unchanged result (a read)
# is refused after this many times (0 = off); tools that observe (cameras) are exempt.
# SECURITY_MAX_IDENTICAL_TOOL_CALLS=2
