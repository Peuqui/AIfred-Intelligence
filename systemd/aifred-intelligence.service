[Unit]
Description=AIfred Intelligence Voice Assistant
# After= keeps the order when Ollama is used as backend; Wants= does not
# pull it in — the Ollama installer enables ollama.service itself, and
# setups on llama-swap/vLLM do not need it running.
After=network.target ollama.service aifred-chromadb.service
Wants=aifred-chromadb.service
# Wants statt Requires: ChromaDB-Recreate (z.B. docker-auto-update.sh
# 03:00) loest sonst einen Cascade-Stop von AIfred aus, was laufende
# Indexierungs-Jobs killt. AIfred starten ohne ChromaDB ist unschoen,
# aber besser als der Cascade-Restart bei jedem ChromaDB-Image-Pull.

[Service]
Type=simple
# Optional .env-Datei einlesen (Secrets, machine-specific Overrides).
# `-` Prefix: kein Fehler wenn die Datei fehlt — viele Setups brauchen
# keine .env, sondern setzen ihre Werte direkt unten als Environment=.
EnvironmentFile=-__PROJECT_DIR__/.env
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment="PATH=__PROJECT_DIR__/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
# ─────────────────────────────────────────────────────────────────
# Machine-specific values do NOT belong here: install-services.sh
# re-renders this file on every run and would overwrite them. Put them
# into <project>/.env (loaded via EnvironmentFile above), e.g.
#   AIFRED_SERVER_PORT=8002               # the default; API, Vue app and folders on one port
#   LLAMACPP_URL=http://localhost:11435/v1
#   LLAMACPP_CALIBRATION_PORT=19999       # the default; set another one if 19999 is taken
# Extra ExecStartPre/ExecStopPost lines: a drop-in via
# `sudo systemctl edit aifred-intelligence` (survives re-installs).
# ─────────────────────────────────────────────────────────────────
# One process serves the API, the built Vue app (frontend/dist, scripts/build-frontend.sh) and the folders.
# KillMode=control-group also ends its child processes (the face worker).
ExecStart=__PROJECT_DIR__/venv/bin/python -m aifred.server
Restart=always
KillMode=control-group
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
